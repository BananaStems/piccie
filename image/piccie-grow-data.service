[Unit]
Description=Expand Piccie data partition before it is mounted
DefaultDependencies=no
Wants=systemd-udev-trigger.service local-fs-pre.target
After=systemd-udev-trigger.service
Before=local-fs-pre.target data.mount data-fallback.service piccie-firstboot-datapart.service piccie-engine.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/piccie-grow-data
TimeoutStartSec=15min
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysinit.target
