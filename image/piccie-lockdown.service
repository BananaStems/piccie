[Unit]
Description=Verify Piccie read-only root or apply recovery override
DefaultDependencies=no
RequiresMountsFor=/boot/firmware
After=boot-firmware.mount
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/piccie-lockdown

[Install]
WantedBy=local-fs.target
