#!/usr/bin/env bash
# Apply Piccie's fixed, device-specific performance profile and schedule reboot.
set -euo pipefail

DEVICE="${1:-}"
MODE="${2:-}"
if [[ "${BASH_SOURCE[0]}" == "/usr/local/sbin/piccie-performance" ]]; then
  CONFIG=/boot/firmware/config.txt
  MODEL_FILE=/proc/device-tree/model
  SYSTEMCTL=/usr/bin/systemctl
else
  CONFIG="${PICCIE_BOOT_CONFIG:-/boot/firmware/config.txt}"
  MODEL_FILE="${PICCIE_MODEL_FILE:-/proc/device-tree/model}"
  SYSTEMCTL="${PICCIE_SYSTEMCTL:-/usr/bin/systemctl}"
fi
REBOOT_UNIT=piccie-performance-reboot
BEGIN="# BEGIN PICCIE PERFORMANCE"
END="# END PICCIE PERFORMANCE"

[[ "${DEVICE}" == "pi4" || "${DEVICE}" == "pi5" ]] || { echo "unsupported device" >&2; exit 2; }
[[ "${MODE}" == "standard" || "${MODE}" == "performance" ]] || { echo "unsupported mode" >&2; exit 2; }
[[ -f "${CONFIG}" ]] || { echo "boot configuration not found" >&2; exit 3; }

MODEL="$(tr -d '\0' <"${MODEL_FILE}" 2>/dev/null || true)"
case "${DEVICE}:${MODEL}" in
  pi4:*"Raspberry Pi 4 Model B"*) ;;
  pi5:*"Raspberry Pi 5"*) ;;
  *) echo "selected device does not match detected hardware" >&2; exit 4 ;;
esac

if [[ "${MODE}" == "performance" && "${DEVICE}" != "pi4" ]]; then
  echo "performance mode is not validated for this device" >&2
  exit 5
fi

TMP="$(mktemp "${CONFIG}.piccie.XXXXXX")"
trap 'rm -f -- "${TMP}"' EXIT
awk -v begin="${BEGIN}" -v end="${END}" '
  $0 == begin { managed=1; next }
  $0 == end { managed=0; next }
  !managed { print }
' "${CONFIG}" >"${TMP}"

if [[ "${MODE}" == "performance" ]]; then
  cat >>"${TMP}" <<'EOF'

# BEGIN PICCIE PERFORMANCE
# Firmware-supported boost for compatible Raspberry Pi 4 revisions.
[pi4]
arm_boost=1
[all]
# END PICCIE PERFORMANCE
EOF
fi

cp -n -- "${CONFIG}" "${CONFIG}.piccie-original" || true
cat "${TMP}" >"${CONFIG}"
rm -f -- "${TMP}"
trap - EXIT
sync "${CONFIG}"

# Restart a preinstalled timer and verify it is active. This leaves enough time
# for the API to save the selected mode and send its response before rebooting.
"${SYSTEMCTL}" stop "${REBOOT_UNIT}.timer" >/dev/null 2>&1 || true
"${SYSTEMCTL}" reset-failed "${REBOOT_UNIT}.service" >/dev/null 2>&1 || true
"${SYSTEMCTL}" start "${REBOOT_UNIT}.timer"
"${SYSTEMCTL}" is-active --quiet "${REBOOT_UNIT}.timer" \
  || { echo "reboot timer did not become active" >&2; exit 6; }
