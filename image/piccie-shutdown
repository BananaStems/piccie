#!/usr/bin/env bash
# Flush writable storage, then power off after the API has time to reply.
set -euo pipefail

if [[ "$(id -u)" -ne 0 && "${PICCIE_ALLOW_NON_ROOT_TEST:-0}" != "1" ]]; then
  echo "piccie-shutdown must run as root" >&2
  exit 2
fi

if [[ "${BASH_SOURCE[0]}" == "/usr/local/sbin/piccie-shutdown" ]]; then
  SYSTEMCTL=/usr/bin/systemctl
else
  SYSTEMCTL="${PICCIE_SYSTEMCTL:?test systemctl path required}"
fi
UNIT=piccie-poweroff
sync
"${SYSTEMCTL}" stop "${UNIT}.timer" >/dev/null 2>&1 || true
"${SYSTEMCTL}" reset-failed "${UNIT}.service" >/dev/null 2>&1 || true
"${SYSTEMCTL}" start "${UNIT}.timer"
"${SYSTEMCTL}" is-active --quiet "${UNIT}.timer" \
  || { echo "poweroff timer did not become active" >&2; exit 3; }
